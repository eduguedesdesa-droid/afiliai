# Copie este arquivo para .env e preencha os valores.

# Connection string do Postgres.
DATABASE_URL="postgresql://afiliai:afiliai_dev@localhost:5432/afiliai_dev?schema=public"

# Chave usada para assinar o cookie de sessão (JWT via jose).
# Gerar uma nova em produção com: openssl rand -base64 32
SESSION_SECRET="troque-por-um-valor-aleatorio-de-32-caracteres-ou-mais"

# URL pública da aplicação (usada em e-mails/links de convite e reset de senha).
APP_URL="http://localhost:3000"
